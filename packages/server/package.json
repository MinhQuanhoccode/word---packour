    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "prisma": "6.19.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
